{
  "name": "<domain>-panel",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "build": "esbuild src/<name>.ts --bundle --minify --format=esm --target=es2021 --outfile=../custom_components/<domain>/panel/<name>.js",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "lit": "^3.2.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.0"
  }
}
